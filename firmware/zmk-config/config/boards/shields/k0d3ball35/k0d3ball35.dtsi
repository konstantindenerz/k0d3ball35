/*
 * k0d3ball35: 35-key wireless split with a 19 mm trackball on the right half.
 *
 * Shared devicetree for both halves. The keyboard is two separate PCBs:
 *   left  = 15 finger keys + 3 thumb keys (matrix row 3, columns 2, 3, 4)
 *   right = 15 finger keys + 2 thumb keys (matrix row 3, columns 3, 4) + PAW3222
 * Both controllers use the identical pin set (spec/01-design-spec.md section 2,
 * Pro Micro numbering of the nice!nano v2), so the kscan GPIOs live here; the
 * per-side overlays only add the column offset and the sensor.
 *
 * Matrix cells (3,0) and (3,1) are empty on both halves, (3,2) only on the right: since r2.3
 * the ball sits where the right half's outer thumb key used to be.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "k0d3ball35-layouts.dtsi"

&k0d3ball35_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &k0d3ball35_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// | pinky | ring | mid | idx | inner |   | inner | idx | mid | ring | pinky |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                RC(3,2) RC(3,3) RC(3,4)    RC(3,9) RC(3,8)
        >;
        // Thumb row, left to right on the desk: left outer, middle, inner (0/10/20 deg),
        // then right inner (col 4 -> 9 with the col-offset) and right middle (col 3 -> 8).
        // The right half has no outer thumb key; the ball pocket is there.
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Scaffold for a trackball on the peripheral half (left-ball build or a
     * dongle build). The peripheral points `trackball_split` at its sensor, the
     * central enables `trackball_split_listener`. Unused in the default build.
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            /* enable on both halves for a left-ball build; the peripheral must
             * also set `device = <&trackball>;` */
            status = "disabled";
        };
    };

    trackball_split_listener: trackball_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
