/*
 * k0d3ball36: 36-key wireless split with a 25 mm trackball.
 *
 * Shared devicetree for both halves. Pin assignments follow
 * docs/01-design-spec.md section 2 (Pro Micro numbering of the nice!nano v2).
 *
 * The PCB is reversible and the controller sits in a plain 2x12 through-hole
 * footprint, so flipping the board for the left half swaps the two controller
 * pin columns. The copper is identical, but the left half therefore sees
 * different controller pins on the same matrix lines. All kscan GPIOs live in
 * the per-side overlays for that reason.
 *
 * The thumb keys live on row 3, columns 2, 3 and 4. Cells (3,0) and (3,1) are empty.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "k0d3ball36-layouts.dtsi"

&k0d3ball36_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &k0d3ball36_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// | pinky | ring | mid | idx | inner |   | inner | idx | mid | ring | pinky |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                RC(3,2) RC(3,3) RC(3,4)    RC(3,9) RC(3,8) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        // row-gpios and col-gpios differ per half (flipped board), see the overlays.
    };

    /*
     * Scaffold for a trackball on the peripheral half (left-ball build or a
     * dongle build). The peripheral points `trackball_split` at its sensor, the
     * central enables `trackball_split_listener`. Unused in the default build.
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            /* enable on both halves for a left-ball build; the peripheral must
             * also set `device = <&trackball>;` */
            status = "disabled";
        };
    };

    trackball_split_listener: trackball_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
